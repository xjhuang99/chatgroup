# Default provider: deepseek (set LLM_PROVIDER=openai to default new bots to GPT)
# LLM_PROVIDER=deepseek
OPENAI_API_KEY=sk-your-openai-key-here

# DeepSeek (OpenAI-compatible): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_CHAT_MODEL=deepseek-chat
# DEEPSEEK_AUX_MODEL=deepseek-chat

# Optional: admin login override (required in production — do not use defaults)
# ADMIN_USERNAME=ACTR2026
# ADMIN_PASSWORD=change-me
# ADMIN_COOKIE_SECURE=true

# Per-group API spend cap (USD, estimated from tokens)
GROUP_SPEND_CAP_USD=8

# Researcher accounts: register at /register, $200 API budget per email (default)
# ACCOUNT_SPEND_CAP_USD=200
# ALLOW_ACCOUNT_REGISTER=true

# Usage alert email (SMTP required). Multiple recipients: comma-separated addresses.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com
# Ops mail group (comma-separated): receives ALL cap alerts + burst/hourly alerts
# ALERT_EMAIL_TO=bbitterly@ust.hk,mlidt@connect.ust.hk,yak@connect.ust.hk,mnsnason@ust.hk,xinjiehuang@ust.hk
# Level 1 cap warning at 80% of budget; Level 2 when cap is reached (bots blocked)
# ALERT_CAP_WARN_RATIO=0.8
# Registered researchers also get Level 1/2 emails for their own account & owned sessions/groups
# ALERT_HOURLY_SPEND_USD=40
# ALERT_GROUP_BURST_USD=15
# ALERT_COOLDOWN_MINUTES=30
